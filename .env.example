# Automatic fallback chain: Gemini -> Groq -> local TF-IDF + MedlinePlus (none)
LLM_PROVIDER=auto

# 1. Primary LLM: Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# 2. Fallback LLM: Groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Optional single-provider or timeout overrides
# LLM_API_KEY=
# LLM_MODEL=
# LLM_FALLBACK_MODEL=
# LLM_BASE_URL=
# LLM_TIMEOUT=25

MEDLINEPLUS_ENABLED=true
# MEDLINEPLUS_TIMEOUT=6

FEEDBACK_PATH=data/feedback.jsonl
RATE_LIMIT_PER_MINUTE=40
