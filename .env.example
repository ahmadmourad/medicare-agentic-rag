# Leave empty to use the built-in grounded fallback with no external model.
LLM_PROVIDER=none

# Gemini example
# LLM_PROVIDER=gemini
# LLM_API_KEY=your-key
# LLM_MODEL=gemini-2.5-flash

# Groq example
# LLM_PROVIDER=groq
# LLM_API_KEY=your-key
# LLM_MODEL=openai/gpt-oss-120b

# Local Ollama example
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.2

MEDLINEPLUS_ENABLED=true
RATE_LIMIT_PER_MINUTE=40
