# Leave empty to use the built-in grounded fallback with no external model.
LLM_PROVIDER=none

# Gemini example
# LLM_PROVIDER=gemini
# LLM_API_KEY=your-key
# LLM_MODEL=gemini-3.5-flash-lite
# LLM_FALLBACK_MODEL=your-fallback-model

# Groq example
# LLM_PROVIDER=groq
# LLM_API_KEY=your-key
# LLM_MODEL=openai/gpt-oss-120b
# LLM_FALLBACK_MODEL=your-fallback-model

# Optional provider overrides
# LLM_BASE_URL=
# LLM_TIMEOUT=25

MEDLINEPLUS_ENABLED=true
# MEDLINEPLUS_TIMEOUT=6

FEEDBACK_PATH=data/feedback.jsonl
RATE_LIMIT_PER_MINUTE=40
